```html
@page
@{
    ViewData["Title"] = "AI Project Assistant";
}

<style>
    .assistant-container {
        max-width: 900px;
        margin: 45px auto;
        padding: 25px;
        font-family: Arial, sans-serif;
    }

    .assistant-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .assistant-header h1 {
        font-size: 36px;
        color: #4338ca;
    }

    .assistant-header p {
        color: #64748b;
        font-size: 16px;
    }

    .assistant-card {
        background: white;
        padding: 28px;
        border-radius: 16px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.08);
    }

    .assistant-card label {
        display: block;
        margin: 18px 0 8px;
        font-weight: bold;
        color: #334155;
    }

    .assistant-card select,
    .assistant-card textarea,
    .assistant-card input {
        width: 100%;
        padding: 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 15px;
        box-sizing: border-box;
    }

    .assistant-card textarea {
        min-height: 140px;
        resize: vertical;
    }

    .assistant-button {
        margin-top: 20px;
        width: 100%;
        padding: 14px;
        background: #4f46e5;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
    }

    .assistant-button:hover {
        background: #3730a3;
    }

    .assistant-result {
        margin-top: 25px;
        padding: 20px;
        background: #eef2ff;
        border-radius: 10px;
        display: none;
        white-space: pre-wrap;
        line-height: 1.7;
    }

    .assistant-note {
        margin-top: 15px;
        font-size: 13px;
        color: #64748b;
    }

    @@media (max-width: 600px) {
        .assistant-container {
            margin: 20px auto;
            padding: 12px;
        }

        .assistant-header h1 {
            font-size: 28px;
        }
    }
</style>

<div class="assistant-container">

    <div class="assistant-header">
        <h1>🤖 AI Project Assistant</h1>
        <p>Your companion for solving project problems and finding solutions.</p>
    </div>

    <div class="assistant-card">

        <form id="assistantForm">

            <label for="projectName">Project Name</label>
            <input id="projectName"
                   type="text"
                   placeholder="Example: Student Attendance System"
                   required />

            <label for="technology">Technology Used</label>
            <select id="technology" required>
                <option value="">Select your technology</option>
                <option>Python</option>
                <option>C# / .NET</option>
                <option>Java</option>
                <option>HTML, CSS and JavaScript</option>
                <option>React</option>
                <option>SQL / Database</option>
                <option>Machine Learning / AI</option>
                <option>Other</option>
            </select>

            <label for="problemType">What do you need help with?</label>
            <select id="problemType" required>
                <option value="">Select a problem type</option>
                <option>Programming Error</option>
                <option>Project Planning</option>
                <option>Database Problem</option>
                <option>UI / Design Problem</option>
                <option>Feature Implementation</option>
                <option>Project Ideas</option>
                <option>Other</option>
            </select>

            <label for="problemDescription">Describe Your Problem</label>
            <textarea id="problemDescription"
                      placeholder="Explain what you are trying to do, what went wrong, and any error message you received..."
                      required></textarea>

            <button class="assistant-button" type="submit">
                Get Project Guidance →
            </button>

        </form>

        <div id="assistantResult"
             class="assistant-result"
             role="status"
             aria-live="polite"></div>

        <p class="assistant-note">
            This interface is currently a prototype. AI-generated answers
            will be added when the assistant is connected to an AI service.
        </p>

    </div>

</div>

<script>
    document.getElementById("assistantForm").addEventListener("submit", function (event) {
        event.preventDefault();

        const projectName = document.getElementById("projectName").value.trim();
        const technology = document.getElementById("technology").value;
        const problemType = document.getElementById("problemType").value;
        const description = document.getElementById("problemDescription").value.trim();

        if (!projectName || !technology || !problemType || !description) {
            return;
        }

        const result = document.getElementById("assistantResult");

        result.style.display = "block";
        result.textContent =
            "Your project details have been collected successfully!\n\n" +
            "Project: " + projectName + "\n" +
            "Technology: " + technology + "\n" +
            "Problem type: " + problemType + "\n\n" +
            "Next step:\n" +
            "Your problem is ready to be processed by the ProjectMate AI service. " +
            "The AI integration has not been configured yet, so this prototype " +
            "does not generate a real solution.\n\n" +
            "Problem submitted:\n" + description;
    });
</script>
```
