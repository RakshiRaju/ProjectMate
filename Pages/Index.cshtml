@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="mast">
    <p class="kicker">A desk for student projects</p>
    <h1>Pick a project you can finish.</h1>
    <p class="lede">
        Mini projects, major projects, the errors that usually stop them,
        and a short order for learning the skills they need.
    </p>
    <form class="finder" method="get" asp-page="/Ideas/Index">
        <label for="home-search">Search project ideas or technologies</label>
        <div class="finder-row">
            <input id="home-search" name="q" type="search" placeholder="Quiz, SQL, booking…" />
            <button type="submit">Search ideas</button>
        </div>
    </form>
</section>

<div class="home-grid">
    <section aria-labelledby="journeys-heading">
        <h2 id="journeys-heading" class="section-label">Start here</h2>
        <ol class="journeys">
            <li>
                <a asp-page="/Ideas/Index">
                    <span class="journey-index">01</span>
                    <span>
                        <strong>Project ideas</strong>
                        <span>@Model.IdeaCount projects, marked mini or major, with the steps to build each one.</span>
                    </span>
                </a>
            </li>
            <li>
                <a asp-page="/Problems/Index">
                    <span class="journey-index">02</span>
                    <span>
                        <strong>Problem solver</strong>
                        <span>@Model.ProblemCount common failures, each with a symptom, a cause, and a fix.</span>
                    </span>
                </a>
            </li>
            <li>
                <a asp-page="/Technologies/Index">
                    <span class="journey-index">03</span>
                    <span>
                        <strong>Technology guide</strong>
                        <span>@Model.TechnologyCount stacks, and the kind of project each one is actually for.</span>
                    </span>
                </a>
            </li>
            <li>
                <a asp-page="/Learning/Index">
                    <span class="journey-index">04</span>
                    <span>
                        <strong>Learning corner</strong>
                        <span>@Model.LessonCount steps, from fundamentals to saving data, tied to a project you can practice on.</span>
                    </span>
                </a>
            </li>
        </ol>
    </section>

    <aside class="featured" aria-labelledby="featured-heading">
        <p class="kicker">Open one</p>
        <h2 id="featured-heading">@Model.Featured.Title</h2>
        <p>@Model.Featured.Summary</p>
        <p class="meta">@Model.Featured.Kind · @Model.Featured.Difficulty</p>
        <ol class="steps">
            @foreach (var step in Model.Featured.Steps.Take(3))
            {
                <li>@step</li>
            }
        </ol>
        <a class="text-link" asp-page="/Ideas/Detail" asp-route-slug="@Model.Featured.Slug">Read the full project</a>
    </aside>
</div>
